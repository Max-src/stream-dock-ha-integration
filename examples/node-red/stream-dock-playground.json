    "type": "function",
    "name": "10 to 0, one a second",
    "func": "const pad = env.get('PAD');\nfor (let n = 10; n >= 0; n--) {\n  setTimeout(() => {\n    node.send({ payload: n > 0\n      ? { device_id: pad, key: 10, title: String(n), message: 'seconds', icon: 'mdi:timer-sand', color: [120, 70, 200], seconds: 2 }\n      : { device_id: pad, key: 10, title: 'Go!', icon: 'mdi:rocket-launch', color: [46, 160, 67], seconds: 8 } });\n  }, (10 - n) * 1000);\n}\nreturn null;",
    "outputs": 1,
