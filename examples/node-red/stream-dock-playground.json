  {
    "type": "function",
    "name": "Colours across the keys",
    "func": "const pad = env.get('PAD');\nconst hsv = (h) => {\n  const f = (n) => { const k = (n + h / 60) % 6; return Math.round(255 * (1 - Math.max(0, Math.min(k, 4 - k, 1)))); };\n  return [f(5), f(3), f(1)];\n};\nfor (let i = 0; i < 15; i++) {\n  setTimeout(() => node.send({ payload: { device_id: pad, key: i + 1, title: ' ', color: hsv(i * 24), icon: 'mdi:circle-small', seconds: 3 } }), i * 120);\n}\nreturn null;",
    "outputs": 1,
